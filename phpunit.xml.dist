<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         failOnDeprecation="false"
         failOnNotice="false"
         failOnWarning="false"
         failOnPhpunitDeprecation="false"
         bootstrap="tests/bootstrap.php"
>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
        <server name="SYMFONY_PHPUNIT_REMOVE" value=""/>
        <server name="SYMFONY_PHPUNIT_VERSION" value="13"/>
        <server name="KERNEL_CLASS" value="App\Kernel"/>
    </php>

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Entity</directory>
            <directory>tests/Enum</directory>
            <directory>tests/Twig</directory>
            <directory>tests/Service</directory>
            <directory>tests/DependencyInjection</directory>
            <directory>tests/MessageHandler</directory>
        </testsuite>
        <testsuite name="security">
            <directory>tests/Security</directory>
        </testsuite>
        <testsuite name="admin">
            <directory>tests/Controller/Admin</directory>
            <directory>tests/Controller/AdminApi</directory>
        </testsuite>
        <testsuite name="auth">
            <directory>tests/Controller/Auth</directory>
        </testsuite>
        <testsuite name="api">
            <directory>tests/Controller/Api</directory>
        </testsuite>
        <testsuite name="settings">
            <directory>tests/Controller/Settings</directory>
        </testsuite>
        <testsuite name="realtime">
            <file>tests/Controller/RealtimeControllerTest.php</file>
            <file>tests/Controller/Cycle53RealtimeMercureSecurityTest.php</file>
        </testsuite>
        <testsuite name="controller">
            <directory>tests/Controller</directory>
            <exclude>tests/Controller/Admin</exclude>
            <exclude>tests/Controller/AdminApi</exclude>
            <exclude>tests/Controller/Auth</exclude>
            <exclude>tests/Controller/Api</exclude>
            <exclude>tests/Controller/Settings</exclude>
            <exclude>tests/Controller/RealtimeControllerTest.php</exclude>
            <exclude>tests/Controller/Cycle53RealtimeMercureSecurityTest.php</exclude>
        </testsuite>
        <testsuite name="graphql">
            <directory>tests/GraphQL</directory>
        </testsuite>
        <testsuite name="events">
            <directory>tests/EventSubscriber</directory>
        </testsuite>
        <testsuite name="command">
            <directory>tests/Command</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
